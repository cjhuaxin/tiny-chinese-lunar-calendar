import { Theme } from "theme.slint";

export component StatusAlertWindow inherits Window {
    width: 320px;
    height: 236px;
    title: "";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font-family;

    in-out property <string> heading;
    in-out property <string> detail;

    callback dismiss();
    callback start-drag();

    Rectangle {
        border-radius: Theme.radius-shell;
        background: Theme.paper-bg;
        border-width: 1px;
        border-color: Theme.paper-border;
        clip: true;

        TouchArea {
            moved => {
                if (self.pressed) {
                    root.start-drag();
                }
            }
        }

        VerticalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 24px;
            padding-bottom: 20px;
            spacing: 0px;

            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../site/app_icon.png");
                    width: 56px;
                    height: 56px;
                    image-fit: contain;
                }
            }

            Rectangle { height: 12px; }

            Text {
                text: root.heading;
                font-size: 16px;
                font-weight: 600;
                color: Theme.ink;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: 8px; }

            Text {
                text: root.detail;
                font-size: 13px;
                color: Theme.ink-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                ok-btn := Rectangle {
                    min-width: 120px;
                    height: 37px;
                    border-radius: 8px;
                    background: ok-ta.has-hover ? Theme.cinnabar-hover-soft : transparent;
                    border-width: 1px;
                    border-color: Theme.paper-border;

                    ok-ta := TouchArea {
                        clicked => { root.dismiss(); }
                        mouse-cursor: pointer;
                    }

                    Text {
                        width: 100%;
                        height: 100%;
                        text: "好";
                        font-size: 14px;
                        color: Theme.ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
